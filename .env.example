# =============================================================================
# NOTARY V2 — Cau hinh moi truong
# Chep file nay thanh .env va dieu chinh cho phu hop
# =============================================================================

# ---------- OCR Cloud AI (Qwen / DashScope) ----------
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_OCR_BASE_URL=https://dashscope-intl.aliyuncs.com
OCR_MODEL=qwen-vl-ocr-2025-11-20
OCR_AI_CONCURRENCY=6
OCR_AI_TIMEOUT_SECONDS=90

# ---------- OCR Cloud AI (OpenAI fallback) ----------
OPENAI_API_KEY=

# ---------- OCR Local ----------
LOCAL_OCR_SMART_CROP_MIN_CONF=0.22
LOCAL_OCR_VIETOCR_MODEL=vgg_transformer
LOCAL_OCR_VIETOCR_BATCH_SIZE=24
LOCAL_OCR_TORCH_THREADS=2
LOCAL_OCR_DEBUG_LOG=1
LOCAL_OCR_TIMING_LOG=1

# ---------- Celery ----------
# Thuong duoc dat tu dong boi run.bat
# CELERY_BROKER_URL=sqlalchemy+sqlite:///ocr_jobs.db
# CELERY_RESULT_BACKEND=db+sqlite:///ocr_jobs.db

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Zalo Document Inbox (local / trusted LAN only) ----------
# Generate two independent random values for these secrets.
ZALO_INBOX_BOOTSTRAP_SECRET=
ZALO_INBOX_WEBHOOK_SECRET=
ZALO_INBOX_BACKEND_URL=http://127.0.0.1:8000
ZALO_INBOX_STORAGE_ROOT=runtime/zalo_inbox/source
ZALO_INBOX_BATCH_ROOT=runtime/zalo_inbox/batches

# Required deployment limits. Choose them from actual server resources; no defaults.
ZALO_INBOX_MAX_FILE_BYTES=
ZALO_INBOX_MAX_ITEMS=
ZALO_INBOX_MAX_TOTAL_BYTES=
ZALO_INBOX_MAX_RENDERED_PIXELS=
ZALO_CONNECTOR_QUOTA_BYTES=
ZALO_CONNECTOR_RETENTION_HOURS=
ZALO_INBOX_TEXT_QUOTA_BYTES=
ZALO_INBOX_TEXT_RETENTION_HOURS=
ZALO_CONNECTOR_STATE_ROOT=runtime/zalo_connector

# ---------- Fast Audit (soat chinh ta) ----------
# FAST_AUDIT_OCR_PROVIDER=qwen
# FAST_AUDIT_OCR_BASE_URL=
# FAST_AUDIT_OCR_API_KEY=
# FAST_AUDIT_OCR_MODEL=
